---
import Base from '../layouts/Base.astro';
import WeekGrid from '../components/WeekGrid.astro';
import schedule from '../data/schedule.json';
---
<Base title="Æfingatafla" description={`Æfingatafla GFK – ${schedule.onn}.`}>
  <section class="page-head">
    <div class="container">
      <h1>Æfingatafla</h1>
      <p>{schedule.onn} · {schedule.stadur}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Fullorðnir</h2>
      <WeekGrid sessions={schedule.fullordnir} />
      <ul class="notes">{schedule.athugasemdir_fullordnir.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container">
      <h2>Krakkar 3–17 ára</h2>
      <p class="line">{schedule.timabil_ungmenna}</p>
      <WeekGrid sessions={schedule.ungmenni} />
      <ul class="notes">{schedule.athugasemdir_ungmenni.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>
  <script is:inline>
    const dagar = ['Sunnudagur','Mánudagur','Þriðjudagur','Miðvikudagur','Fimmtudagur','Föstudagur','Laugardagur'];
    const wd = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(new Intl.DateTimeFormat('en-GB', { timeZone: 'Atlantic/Reykjavik', weekday: 'short' }).format(new Date()));
    const idag = dagar[wd];
    document.querySelectorAll('.wk').forEach((wk) => {
      const days = [...wk.querySelectorAll('.wk-day')];
      let i = Math.max(0, days.findIndex((d) => d.getAttribute('aria-label') === idag));
      days[i]?.classList.add('wk-today');
      days[i]?.querySelector('.wk-head')?.insertAdjacentHTML('beforeend', '<span class="today-tag">Í dag</span>');
      const nav = document.createElement('div');
      nav.className = 'wk-flip';
      nav.innerHTML = '<button type="button" aria-label="Fyrri dagur">‹</button><strong></strong><button type="button" aria-label="Næsti dagur">›</button>';
      wk.before(nav);
      const show = () => {
        days.forEach((d, k) => d.classList.toggle('wk-cur', k === i));
        nav.querySelector('strong').textContent = days[i].getAttribute('aria-label') + (days[i].classList.contains('wk-today') ? ' · í dag' : '');
      };
      const [prev, next] = nav.querySelectorAll('button');
      prev.onclick = () => { i = (i + days.length - 1) % days.length; show(); };
      next.onclick = () => { i = (i + 1) % days.length; show(); };
      wk.classList.add('wk-flippable');
      show();
    });
  </script>
</Base>

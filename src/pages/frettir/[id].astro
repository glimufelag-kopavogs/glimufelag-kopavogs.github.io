---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = (await getCollection('frettir', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('is-IS', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={post.data.title}>
  <article>
    <section class="page-head">
      <div class="container">
        <a class="small" href="/frettir/">← Fréttir</a>
        <h1 style="margin-top:12px;font-size:clamp(2rem,4.5vw,3.2rem)">{post.data.title}</h1>
        <p><time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>{post.data.hofundur && <> · {post.data.hofundur}</>}</p>
      </div>
    </section>
    <section class="section">
      <div class="container"><div class="prose">
        {post.data.yfirfara_personuvernd && <span class="tag-review">Persónuvernd: í yfirferð</span>}
        <Content />
        {post.data.upprunaleg_slod && <p class="small" style="margin-top:32px"><a href={post.data.upprunaleg_slod} rel="noopener">Upprunaleg frétt ↗</a></p>}
      </div></div>
    </section>
    <nav class="container post-nav" aria-label="Fleiri fréttir">
      {older ? <a class="card" href={`/frettir/${older.id}/`}><span class="small muted">← Eldri</span><br />{older.data.title}</a> : <span />}
      {newer ? <a class="card" style="text-align:right" href={`/frettir/${newer.id}/`}><span class="small muted">Nýrri →</span><br />{newer.data.title}</a> : <span />}
    </nav>
  </article>
</Base>
